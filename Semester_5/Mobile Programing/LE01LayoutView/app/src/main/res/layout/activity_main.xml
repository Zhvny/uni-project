<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="20dp"
        android:hint="Input angka ke-1 disini"
        android:id="@+id/edtInput1"/>
    
    <EditText
        android:layout_width="105dp"
        android:layout_height="wrap_content"
        android:hint="Operator"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_below="@+id/edtInput1"
        android:id="@+id/edtOperator"/>
    
    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Input angka ke-2 disini"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_below="@+id/edtOperator"
        android:id="@+id/edtInput2"/>
    
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hasil disini"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:textSize="50sp"
        android:layout_below="@+id/edtInput2"
        android:id="@+id/hasil"/>
    
    <Button
        android:layout_width="75dp"
        android:layout_height="wrap_content"
        android:text="1"
        android:layout_marginLeft="20dp"
        android:layout_below="@+id/hasil"
        android:id="@+id/btn1"/>
    <Button
        android:layout_width="75dp"
        android:layout_height="wrap_content"
        android:text="2"
        android:layout_below="@+id/hasil"
        android:layout_toRightOf="@+id/btn1"
        android:id="@+id/btn2"/>
    <Button
        android:layout_width="75dp"
        android:layout_height="wrap_content"
        android:text="3"
        android:layout_below="@+id/hasil"
        android:layout_toRightOf="@+id/btn2"
        android:id="@+id/btn3"/>
    <Button
        android:layout_width="75dp"
        android:layout_height="wrap_content"
        android:text="4"
        android:layout_below="@+id/hasil"
        android:layout_toRightOf="@+id/btn3"
        android:id="@+id/btn4"/>
    <Button
        android:layout_width="75dp"
        android:layout_height="wrap_content"
        android:text="5"
        android:layout_marginRight="20dp"
        android:layout_below="@+id/hasil"
        android:layout_toRightOf="@+id/btn4"
        android:id="@+id/btn5"/>

    <Button
        android:layout_width="75dp"
        android:layout_height="wrap_content"
        android:text="6"
        android:layout_marginLeft="20dp"
        android:layout_below="@+id/btn1"
        android:id="@+id/btn6"/>
    <Button
        android:layout_width="75dp"
        android:layout_height="wrap_content"
        android:text="7"
        android:layout_below="@+id/btn1"
        android:layout_toRightOf="@+id/btn6"
        android:id="@+id/btn7"/>
    <Button
        android:layout_width="75dp"
        android:layout_height="wrap_content"
        android:text="8"
        android:layout_below="@+id/btn1"
        android:layout_toRightOf="@+id/btn7"
        android:id="@+id/btn8"/>
    <Button
        android:layout_width="75dp"
        android:layout_height="wrap_content"
        android:text="9"
        android:layout_below="@+id/btn1"
        android:layout_toRightOf="@+id/btn8"
        android:id="@+id/btn9"/>
    <Button
        android:layout_width="75dp"
        android:layout_height="wrap_content"
        android:text="0"
        android:layout_marginRight="20dp"
        android:layout_below="@+id/btn1"
        android:layout_toRightOf="@+id/btn9"
        android:id="@+id/btn0"/>

    <Button
        android:layout_width="75dp"
        android:layout_height="wrap_content"
        android:text="+"
        android:layout_marginLeft="20dp"
        android:layout_below="@+id/btn6"
        android:id="@+id/btnPlus"/>
    <Button
        android:layout_width="75dp"
        android:layout_height="wrap_content"
        android:text="-"
        android:layout_below="@+id/btn6"
        android:layout_toRightOf="@+id/btnPlus"
        android:id="@+id/btnMinus"/>
    <Button
        android:layout_width="75dp"
        android:layout_height="wrap_content"
        android:text="*"
        android:layout_below="@+id/btn6"
        android:layout_toRightOf="@+id/btnMinus"
        android:id="@+id/btnMultiple"/>
    <Button
        android:layout_width="75dp"
        android:layout_height="wrap_content"
        android:text="/"
        android:layout_below="@+id/btn6"
        android:layout_toRightOf="@+id/btnMultiple"
        android:id="@+id/btnDevide"/>
    <Button
        android:layout_width="75dp"
        android:layout_height="wrap_content"
        android:text="="
        android:layout_marginRight="20dp"
        android:layout_below="@+id/btn6"
        android:layout_toRightOf="@id/btnDevide"
        android:id="@+id/btnEqual"/>
</RelativeLayout>